# WhatsApp number that receives reservations and orders.
# International format, digits only, no "+" — e.g. 2207XXXXXX for a Gambian number.
# If left empty, WhatsApp opens with the message ready and the guest picks the chat.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: public site URL (used for SEO / social previews)
NEXT_PUBLIC_SITE_URL=https://mayasresto.vercel.app

# Optional: contact email shown in the Location section
NEXT_PUBLIC_CONTACT_EMAIL=
